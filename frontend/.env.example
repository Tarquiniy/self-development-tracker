# =========================
# Next.js (frontend) settings
# =========================
#
# Public vars (доступны на клиенте через NEXT_PUBLIC_*)

NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (client-side)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Origins / redirect
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Telegram Login Widget (client-side)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YOUR_TELEGRAM_BOT_USERNAME

# Yandex OAuth (если используете)
NEXT_PUBLIC_YANDEX_CLIENT_ID=YOUR_YANDEX_CLIENT_ID


# =========================
# Server-side vars (доступны только на сервере)
# =========================
#
# Supabase admin (нужны для серверных route/handlers в Next.js)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Telegram backend (для Next.js API route)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Used for redirects/links in Next.js server routes
SITE_URL=http://localhost:3000

# Optional: extra debug for telegram flow
DEBUG_TELEGRAM=false

